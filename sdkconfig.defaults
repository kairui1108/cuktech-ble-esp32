# BT — NimBLE host on CPU 1 (CPU 0 is WiFi/TCP-IP)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_PINNED_TO_CORE_1=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BT_NIMBLE_4_1_COMPAT=y
CONFIG_BT_NIMBLE_LOG_LEVEL=4
# NimBLE memory tuning — single-device, relaxed enough for service discovery
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=255
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=256
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=6
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=6
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MAX_BONDS=1
# ATT_PREFERRED_MTU left at default (256)

# MQTT
CONFIG_MQTT_PROTOCOL_311=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Flash size
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# HTTP Server (prevent ENFILE fd exhaustion)
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# LWIP
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=4096
CONFIG_LWIP_TCP_WND_DEFAULT=4096
CONFIG_LWIP_TCP_MSS=1460
# LWIP internal memory — prevent TCP depletion under fragmentation
CONFIG_LWIP_MEM_SIZE=8192
CONFIG_LWIP_PBUF_POOL_SIZE=12
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
# Disable OOSEQ to reduce per-connection memory when fragmented
CONFIG_LWIP_TCP_QUEUE_OOSEQ=n

# mbedTLS (for crypto)
CONFIG_MBEDTLS_MD_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_SHA256_C=y
CONFIG_MBEDTLS_HKDF_C=y
