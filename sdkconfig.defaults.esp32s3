# ESP32-S3 overrides
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
# Disable 4.1 compat — S3 is BLE 5.0
# CONFIG_BT_NIMBLE_4_1_COMPAT is not set

# NimBLE memory tuning — increased MSYS_1 blocks to prevent mbuf exhaustion
# during notification bursts (BLE scan + GATT discovery + data push concurrently)
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_ACL_BUF_SIZE=255
CONFIG_BT_NIMBLE_HCI_EVT_BUF_SIZE=256
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=8
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=8
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=16
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096

# MQTT
CONFIG_MQTT_PROTOCOL_311=y

# Partition Table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# FreeRTOS
CONFIG_FREERTOS_HZ=1000
# Increase Task WDT timeout for long BLE auth operations (dual-core, but BLE ops can block)
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30

# HTTP Server
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=1024

# LWIP
CONFIG_LWIP_MAX_SOCKETS=16
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_TCP_MSS=1460
# LWIP internal memory — prevent TCP depletion under fragmentation
CONFIG_LWIP_MEM_SIZE=8192
CONFIG_LWIP_PBUF_POOL_SIZE=16
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=3072
# Disable OOSEQ to reduce per-connection memory when fragmented
CONFIG_LWIP_TCP_QUEUE_OOSEQ=n
# TCP keep-alive for MQTT long-lived connections (prevent NAT timeouts)
CONFIG_LWIP_TCP_KEEPALIVE=y
# Disable SO_REUSE to prevent port exhaustion on frequent reconnects
CONFIG_LWIP_SO_REUSE=n
# Nagle disabled for low-latency MQTT publish (small payloads sent immediately)
CONFIG_LWIP_TCP_NODELAY=y

# mbedTLS (for crypto)
CONFIG_MBEDTLS_MD_C=y
CONFIG_MBEDTLS_CCM_C=y
CONFIG_MBEDTLS_SHA256_C=y
CONFIG_MBEDTLS_HKDF_C=y

# --- Heap & Memory ---
# Enable task stack overflow detection (catches stack smashing early)
CONFIG_FREERTOS_CHECK_STACKOVERFLOW_CANARY=y
# Enable TLSF allocator — O(1) allocation, immediate coalescing, reduces fragmentation ~60-80%
CONFIG_HEAP_TLSF_USE_MALLOC=y
